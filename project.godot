config_version=5

[application]
config/name="24 HR Towing"
config/description="Run the last wrecker in Tamarack County, Wisconsin."
config/version="0.1.0"
run/main_scene="res://game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="res://assets/art/wrecker.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color(0.106, 0.137, 0.188, 1)
config/icon="res://assets/art/wrecker.png"
run/max_fps=30
config/quit_on_go_back=false

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.106,0.137,0.188,1)

[shader_globals]

headlamp_left={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
headlamp_right={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
headlamp_direction={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

headlamp_power={
"type": "float",
"value": 1.0
}

driving_lamps={
"type": "float",
"value": 0.0
}
